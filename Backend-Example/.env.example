# Copy this file to .env and fill the values before running the app
# IMPORTANT: Do NOT put real credentials in this example file. Keep secrets in a local
# `.env` file which is included in .gitignore.
# Example:
# PORT=3000
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

PORT=3000
MONGODB_URI=mongodb://localhost:27017/backend-example
